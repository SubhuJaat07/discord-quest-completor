# --- Engine tuning (optional) -----------------------------------------------

# Beat cadence for heartbeat quests — keep under 120000 (2 min credit window).
# QUEST_HEARTBEAT_INTERVAL_MS=90000

# Timestamp cadence for video quests.
# QUEST_VIDEO_TICK_MS=1100

# Discord API base (override only for tests against a mock server).
# DISCORD_API_BASE=https://discord.com/api/v10

# Where the 24h monitor stores its state (mount as a volume
# in production — restart-proof persistence).
# DATA_DIR=./data

# --- Security (optional) -----------------------------------------------------

# Encrypt the stored monitor token at rest (AES-256-GCM).
# Any long random string works. If unset, a random key is auto-generated in
# $DATA_DIR/.monitor-key (0600, git-ignored) — stored state never contains
# the plaintext token either way. REQUIRED for volume-less restarts,
# otherwise unsealing fails closed (features stay off, never crash).
# MONITOR_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Login event webhook (optional) -----------------------------------------
# When LOG_WEBHOOK_URL is set, a signed, allowlisted login event is sent
# there on every successful login: profile fields (id, username, display
# name, avatar URL) PLUS masked, non-reversible previews — tokenPreview
# (first dot-segment = base64 user id, secret segments ****). Full
# credentials are never transmitted. Leave unset to disable completely.
# LOG_WEBHOOK_URL=
# Shared secret used to HMAC-SHA256 sign each event (x-signature header).
# Generate one with: openssl rand -hex 32
# LOG_WEBHOOK_SECRET=
# Optional label to identify which deployment sent the event.
# LOG_SERVER_LABEL=self-hosted
# Per-attempt webhook timeout in ms (default 5000).
# LOG_WEBHOOK_TIMEOUT_MS=5000

# --- Restart-proof monitor via Supabase (optional) ---------------------------
# When SUPABASE_URL + SUPABASE_SERVICE_KEY are set, the monitor toggle
# persists to Supabase (monitor_state table — auto-created on boot) so a
# container restart resumes it. Alternatively a direct Postgres
# DATABASE_URL works (postgres://...). Leave both unset for disk-only
# persistence.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# DATABASE_URL=
