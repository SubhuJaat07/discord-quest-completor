DATABASE_URL=file:./db/custom.db

# --- Security (optional) -----------------------------------------------------

# Encrypt the 24h-monitor's stored token at rest (AES-256-GCM).
# Any long random string works. If unset, a random key is auto-generated in
# $DATA_DIR/.monitor-key (0600, git-ignored) — monitor.json never contains
# the plaintext token either way.
# MONITOR_ENCRYPTION_KEY=change-me-to-a-long-random-string

# /api/debug is OFF unless DEBUG_ENABLED=true. When on, it additionally
# requires login cookies, and the header 'x-debug-key: <DEBUG_KEY>' if
# DEBUG_KEY is set. Responses never include tokens.
# DEBUG_ENABLED=false
# DEBUG_KEY=another-long-random-string
